{
  "xsappname": "figaf-faid",
  "tenant-mode": "dedicated",
  "description": "Figaf Platform: roles of the Figaf Manager and of all FAID Apps in this installation. Identifiers frozen by decisions 0008, 0009 and 0014 - add, never rename.",
  "scopes": [
    {
      "name": "$XSAPPNAME.FAIDManagerOperator",
      "description": "Figaf Manager: operate the installation (install, update, connect, sign in)"
    },
    {
      "name": "$XSAPPNAME.FAIDManagerAdmin",
      "description": "Figaf Manager: destructive operations (remove apps, delete deployments)"
    }
  ],
  "role-templates": [
    {
      "name": "FAIDManagerOperator",
      "description": "Figaf Manager - operator",
      "scope-references": [
        "$XSAPPNAME.FAIDManagerOperator"
      ]
    },
    {
      "name": "FAIDManagerAdmin",
      "description": "Figaf Manager - administrator (includes operator)",
      "scope-references": [
        "$XSAPPNAME.FAIDManagerOperator",
        "$XSAPPNAME.FAIDManagerAdmin"
      ]
    }
  ],
  "role-collections": [
    {
      "name": "FAID-Manager-Operator",
      "description": "Figaf Manager - operator",
      "role-template-references": [
        "$XSAPPNAME.FAIDManagerOperator"
      ]
    },
    {
      "name": "FAID-Manager-Admin",
      "description": "Figaf Manager - administrator",
      "role-template-references": [
        "$XSAPPNAME.FAIDManagerAdmin"
      ]
    }
  ],
  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.__CF_APPS_DOMAIN__/**"
    ],
    "token-validity": 3600,
    "refresh-token-validity": 86400
  }
}
